<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>KeePassXC</string>
  <key>CFBundleExecutable</key>
  <string>@AUTOFILL_EXTENSION_NAME@</string>
  <key>CFBundleIdentifier</key>
  <string>@AUTOFILL_EXTENSION_IDENTIFIER@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>@AUTOFILL_EXTENSION_NAME@</string>
  <key>CFBundlePackageType</key>
  <string>XPC!</string>
  <key>CFBundleShortVersionString</key>
  <string>@KEEPASSXC_VERSION_MAJOR@.@KEEPASSXC_VERSION_MINOR@.@KEEPASSXC_VERSION_PATCH@</string>
  <key>CFBundleVersion</key>
  <string>@KEEPASSXC_VERSION_MAJOR@.@KEEPASSXC_VERSION_MINOR@.@KEEPASSXC_VERSION_PATCH@</string>
  <key>LSMinimumSystemVersion</key>
  <string>@AUTOFILL_DEPLOYMENT_TARGET@</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright 2016-2026 KeePassXC Development Team</string>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionAttributes</key>
    <dict>
      <key>ASCredentialProviderExtensionCapabilities</key>
      <dict>
        <key>ProvidesPasswords</key>
        <true/>
        <key>ProvidesPasskeys</key>
        <true/>
        <key>ProvidesOneTimeCodes</key>
        <true/>
        <key>ShowsConfigurationUI</key>
        <true/>
      </dict>
      <key>ASCredentialProviderExtensionShowsConfigurationUI</key>
      <true/>
    </dict>
    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.authentication-services-credential-provider-ui</string>
    <key>NSExtensionPrincipalClass</key>
    <string>KPXCredentialProviderViewController</string>
  </dict>
</dict>
</plist>

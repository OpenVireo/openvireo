   <item>
    <widget class="QStackedWidget" name="pages">
     <widget class="QWidget" name="detailsPage">
      <layout class="QVBoxLayout" name="detailsLayout">
       <item>
        <widget class="QLabel" name="detailsIntro">
         <property name="text">
          <string>Your account keeps your vaults in sync on all your devices and lets you share them. Everything is encrypted on your devices with your master password and a Secret Key that only you have.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>

/* High contrast: solid borders, no tinted fills, state never shown by colour alone */

/* Hovered buttons take the highlight colours, as in the Windows high-contrast themes */
QPushButton:!default:hover, QPushButton:default:hover, QPushButton:checked:hover {
    background: palette(highlight);
    color: palette(highlighted-text);
}

QMenu {
    border: 1px solid palette(window-text);
}

QMenu::separator {
    height: 1px;
    background-color: palette(window-text);
}

/* Fluent menus paint their own border and separators */
fluent--menus_toolbars--FluentMenu {
    border: none;
}

QToolTip {
    color: palette(tooltip-text);
    background-color: palette(tooltip-base);
    border: 1px solid palette(tooltip-text);
}

QGroupBox::title {
    color: palette(window-text);
}

DatabaseWidget:!active,
DatabaseWidget #groupView:!active, DatabaseWidget #tagView:!active,
DatabaseWidget:disabled,
DatabaseWidget #groupView:disabled, DatabaseWidget #tagView:disabled {
    background-color: palette(window);
}

DatabaseWidget #SearchBanner {
    border: 1px solid palette(window-text);
}
